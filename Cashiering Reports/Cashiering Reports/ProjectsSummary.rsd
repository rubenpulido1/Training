<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@startDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@endDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>SELECT
  Project2.ProjectNumber, Project2.Description,
  SUM(
  CASE
    WHEN FeeDistributions.Percentage = 1 THEN ROUND(Transactions_LineItems.Amount * (FeeDistributions.Amount/ 100.00), 2)
    ELSE FeeDistributions.Amount
  END
  ) AS AllocatedAmount

FROM Transactions INNER JOIN
  Transactions_LineItems ON Transactions.Id = Transactions_LineItems.TransactionId INNER JOIN
  FeeDistributions ON Transactions_LineItems.FeeId = FeeDistributions.FeeId INNER JOIN
  Funds ON FeeDistributions.FundId = Funds.Id 
  CROSS APPLY (
    SELECT TOP 1
    *
  FROM Funds F2
  WHERE F2.VersionSetId = Funds.VersionSetId
  ORDER BY F2.EffectiveDate DESC
) Funds2
  INNER JOIN
  Projects ON Funds2.ProjectId = Projects.Id
CROSS APPLY (
    SELECT TOP 1
    *
  FROM Projects P2
  WHERE P2.VersionSetId = Projects.VersionSetId
  ORDER BY P2.EffectiveDate DESC
) Project2

WHERE 
  (Transactions.TransactionDate BETWEEN @startDate AND @endDate)
  AND (Transactions.UnitId = @unitId)
  AND FeeDistributions.EffectiveDate &lt;= CAST(Transactions.TransactionDate AS DATE)
  AND (FeeDistributions.EffectiveEndDate IS NULL OR FeeDistributions.EffectiveEndDate &gt; CAST(Transactions.TransactionDate AS DATE))

GROUP BY Project2.ProjectNumber, Project2.Description
ORDER BY Project2.ProjectNumber</CommandText>
    </Query>
    <Fields>
      <Field Name="ProjectNumber">
        <DataField>ProjectNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Description">
        <DataField>Description</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="AllocatedAmount">
        <DataField>AllocatedAmount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>