<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@directDeposit">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Boolean</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@date">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>WITH PaymentTotals AS (
    SELECT 
        TransactionId,
        SUM(Amount) AS TotalPayments
    FROM Transactions_Payments
    GROUP BY TransactionId
),
TotalPayments AS (
    SELECT 
        tp.PaymentOptionId, 
        tp.Amount - (t.ChangeDue * (tp.Amount / NULLIF(pt.TotalPayments, 0))) AS Amount
    FROM Transactions_Payments AS tp 
    INNER JOIN Transactions AS t ON t.Id = tp.TransactionId
    INNER JOIN PaymentTotals pt ON pt.TransactionId = t.Id
    WHERE t.UnitId = @unitId
        AND CAST(t.TransactionDate AS DATE) = @date
        AND t.VoidedStatus_VoidedOn IS NULL
    
    UNION ALL
    
    SELECT 
        osa.PaymentOptionId, 
        osa.Amount
    FROM OverShortAdjustments AS osa
    WHERE osa.UnitId = @unitId
        AND osa.DepositDate = @date
    
    UNION ALL
    
    SELECT 
        pma.FromPaymentOptionId AS PaymentOptionId, 
        -pma.Amount AS Amount
    FROM PaymentMethodAdjustments AS pma
    WHERE pma.UnitId = @unitId
        AND pma.DepositDate = @date
    
    UNION ALL
    
    SELECT 
        pma.ToPaymentOptionId AS PaymentOptionId, 
        pma.Amount AS Amount
    FROM PaymentMethodAdjustments AS pma
    WHERE pma.UnitId = @unitId
        AND pma.DepositDate = @date
)
SELECT 
    po.PaymentMethod,
    SUM(tp.Amount) AS Amount
FROM TotalPayments AS tp 
INNER JOIN PaymentOptions AS po ON po.Id = tp.PaymentOptionId
WHERE (@directDeposit = 1) OR (po.PaymentMethod NOT IN ('Direct Deposit', 'DIR'))
GROUP BY po.PaymentMethod
ORDER BY po.PaymentMethod;</CommandText>
    </Query>
    <Fields>
      <Field Name="Amount">
        <DataField>Amount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
      <Field Name="PaymentMethod">
        <DataField>PaymentMethod</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>