<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@date">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@paymentOptionId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>WITH PaymentTotals AS (SELECT        TransactionId, SUM(Amount) AS TotalPayments
                                                       FROM            Transactions_Payments
                                                       GROUP BY TransactionId), TotalPayments AS
    (SELECT        tp.PaymentOptionId, tp.Amount - t.ChangeDue * (tp.Amount / NULLIF (pt.TotalPayments, 0)) AS Amount
      FROM            Transactions_Payments AS tp INNER JOIN
                                Transactions AS t ON t.Id = tp.TransactionId INNER JOIN
                                PaymentTotals AS pt ON pt.TransactionId = t.Id
      WHERE        (t.UnitId = @unitId) AND (CAST(t.TransactionDate AS DATE) = @date) AND (t.VoidedStatus_VoidedOn IS NULL)
      UNION ALL
      SELECT        PaymentOptionId, Amount
      FROM            OverShortAdjustments AS osa
      WHERE        (UnitId = @unitId) AND (DepositDate = @date)
      UNION ALL
      SELECT        FromPaymentOptionId AS PaymentOptionId, - Amount AS Amount
      FROM            PaymentMethodAdjustments AS pma
      WHERE        (UnitId = @unitId) AND (DepositDate = @date)
      UNION ALL
      SELECT        ToPaymentOptionId AS PaymentOptionId, Amount
      FROM            PaymentMethodAdjustments AS pma
      WHERE        (UnitId = @unitId) AND (DepositDate = @date))
    SELECT        po.PaymentMethod, SUM(tp.Amount) AS Amount
     FROM            TotalPayments AS tp INNER JOIN
                              PaymentOptions AS po ON po.Id = tp.PaymentOptionId
     WHERE po.Id IN (
                    SELECT CAST(TRIM(value) AS UNIQUEIDENTIFIER)
          FROM STRING_SPLIT(@paymentOptionId, ',')
                )
     GROUP BY po.PaymentMethod
     ORDER BY po.PaymentMethod</CommandText>
    </Query>
    <Fields>
      <Field Name="PaymentMethod">
        <DataField>PaymentMethod</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Amount">
        <DataField>Amount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>