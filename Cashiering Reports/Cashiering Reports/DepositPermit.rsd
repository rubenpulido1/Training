<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@date">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@paymentOptionId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>WITH
  TempFund
  AS
  (
          SELECT
        CASE 
            WHEN Transactions_LineItems.ProjectComment IS NOT NULL
          AND TRIM(Transactions_LineItems.ProjectComment) &lt;&gt; '' 
            THEN Transactions_LineItems.ProjectComment 
            ELSE Funds2.Description 
        END AS FundDescription,
        Funds2.FundNumber AS FundNumber,
        Funds2.BudgetNumber AS FundDeptNumber,
        Funds2.AccountNumber AS FundAccountNumber,
        Projects2.ProjectNumber AS ProjectNumber,
        FeeDistributions.Amount AS DistributionAmount,
        Transactions_LineItems.Amount AS LineItemAmount,
        Transactions_LineItems.Quantity,
        FeeDistributions.Percentage AS IsPercentage,
        PaymentOptions.PaymentMethod AS PaymentMethod,
        Transactions.InvoiceNumber,
        Transactions.Amount AS TotalAmount,
        CAST(Transactions.TransactionDate AS DATE) AS TransactionDate,
        0 AS IsAdjustment,
        Transactions_LineItems.Id AS LineItemId,
        ROW_NUMBER() OVER (
            PARTITION BY Transactions_LineItems.Id, Funds2.VersionSetId
            ORDER BY Funds2.EffectiveDate DESC, Projects2.EffectiveDate DESC
        ) AS Rank,
        Transactions_LineItems.ProjectComment
      FROM Transactions INNER JOIN
        Transactions_Payments ON Transactions_Payments.TransactionId = Transactions.Id INNER JOIN
        PaymentOptions ON PaymentOptions.Id = Transactions_Payments.PaymentOptionId INNER JOIN
        Transactions_LineItems ON Transactions.Id = Transactions_LineItems.TransactionId INNER JOIN
        FeeDistributions ON Transactions_LineItems.FeeId = FeeDistributions.FeeId INNER JOIN
        Funds ON FeeDistributions.FundId = Funds.Id INNER JOIN
        Funds Funds2 ON Funds.VersionSetId = Funds2.VersionSetId LEFT OUTER JOIN
        Projects ON Funds2.ProjectId = Projects.Id
          AND Projects.EffectiveDate &lt;= @date
          AND (Projects.EffectiveEndDate IS NULL OR Projects.EffectiveEndDate &gt; @date) LEFT OUTER JOIN
        Projects Projects2 ON Projects.VersionSetId = Projects2.VersionSetId
          AND Projects2.EffectiveDate &lt;= @date
          AND (Projects2.EffectiveEndDate IS NULL OR Projects2.EffectiveEndDate &gt; @date)
      WHERE Transactions.VoidedStatus_VoidedOn IS NULL
        AND Transactions.UnitId = @unitId
        AND CAST(Transactions.TransactionDate AS DATE) = @date
        AND Funds2.EffectiveDate &lt;= @date
        AND (Funds2.EffectiveEndDate IS NULL OR Funds2.EffectiveEndDate &gt;= @date)
        AND FeeDistributions.EffectiveDate &lt;= @date
        AND (FeeDistributions.EffectiveEndDate IS NULL OR FeeDistributions.EffectiveEndDate &gt;= @date)
        AND EXISTS
      (
          SELECT 1
        FROM Transactions_Payments
          INNER JOIN PaymentOptions
          ON PaymentOptions.Id = Transactions_Payments.PaymentOptionId
        WHERE Transactions_Payments.TransactionId = Transactions.Id
          AND PaymentOptions.Id IN
            (
                SELECT CAST(TRIM(value) AS UNIQUEIDENTIFIER)
          FROM STRING_SPLIT(@paymentOptionId, ',')
            )
      )

    UNION ALL

      SELECT
        CASE 
            WHEN Transactions_LineItems.ProjectComment IS NOT NULL
          AND TRIM(Transactions_LineItems.ProjectComment) &lt;&gt; '' 
            THEN Transactions_LineItems.ProjectComment + ' - Adjustment'
            ELSE Funds2.Description + ' - Adjustment' 
        END AS FundDescription,
        Funds2.FundNumber AS FundNumber,
        Funds2.BudgetNumber AS FundDeptNumber,
        Funds2.AccountNumber AS FundAccountNumber,
        COALESCE(AdjustmentProjects.ProjectNumber, Projects2.ProjectNumber) AS ProjectNumber,
        FeeDistributions.Amount AS DistributionAmount,
        Transactions_LineItems.Amount AS LineItemAmount,
        Transactions_LineItems.Quantity,
        FeeDistributions.Percentage AS IsPercentage,
        PaymentOptions.PaymentMethod AS PaymentMethod,
        Transactions.InvoiceNumber,
        OverShortAdjustments.Amount AS TotalAmount,
        OverShortAdjustments.DepositDate AS TransactionDate,
        1 AS IsAdjustment,
        Transactions_LineItems.Id AS LineItemId,
        ROW_NUMBER() OVER (
            PARTITION BY Transactions_LineItems.Id, Funds2.VersionSetId
            ORDER BY Funds2.EffectiveDate DESC, Projects2.EffectiveDate DESC
        ) AS Rank,
        Transactions_LineItems.ProjectComment
      FROM OverShortAdjustments INNER JOIN
        Transactions ON OverShortAdjustments.TransactionId = Transactions.Id INNER JOIN
        Transactions_LineItems ON Transactions.Id = Transactions_LineItems.TransactionId INNER JOIN
        FeeDistributions ON Transactions_LineItems.FeeId = FeeDistributions.FeeId INNER JOIN
        Funds ON FeeDistributions.FundId = Funds.Id INNER JOIN
        Funds AS Funds2 ON Funds.VersionSetId = Funds2.VersionSetId LEFT OUTER JOIN
        Projects ON Funds2.ProjectId = Projects.Id
          AND Projects.EffectiveDate &lt;= @date
          AND (Projects.EffectiveEndDate IS NULL OR Projects.EffectiveEndDate &gt; @date) LEFT OUTER JOIN
        Projects Projects2 ON Projects.VersionSetId = Projects2.VersionSetId
          AND Projects2.EffectiveDate &lt;= @date
          AND (Projects2.EffectiveEndDate IS NULL OR Projects2.EffectiveEndDate &gt; @date) LEFT OUTER JOIN
        Projects AS AdjustmentProjects ON OverShortAdjustments.ProjectId = AdjustmentProjects.Id
          AND AdjustmentProjects.EffectiveDate &lt;= @date
          AND (AdjustmentProjects.EffectiveEndDate IS NULL OR AdjustmentProjects.EffectiveEndDate &gt; @date) INNER JOIN
        PaymentOptions ON OverShortAdjustments.PaymentOptionId = PaymentOptions.Id
      WHERE OverShortAdjustments.UnitId = @unitId
        AND OverShortAdjustments.DepositDate = @date
        AND Funds2.EffectiveDate &lt;= @date
        AND (Funds2.EffectiveEndDate IS NULL OR Funds2.EffectiveEndDate &gt; @date)
        AND FeeDistributions.EffectiveDate &lt;= @date
        AND (FeeDistributions.EffectiveEndDate IS NULL OR FeeDistributions.EffectiveEndDate &gt; @date)
        AND PaymentOptions.Id IN
      (
          SELECT CAST(TRIM(value) AS UNIQUEIDENTIFIER)
        FROM STRING_SPLIT(@paymentOptionId, ',')
      )
  )

SELECT PaymentMethod, FundDescription, FundNumber, FundDeptNumber, FundAccountNumber, ProjectNumber, Rank,
  SUM(LineItemTotal) AS Amount,
  CASE 
        WHEN SUM(HasProjectComment) = 0 THEN MAX(TotalAmount)
        ELSE SUM(LineItemTotal)
    END AS Total,
  TransactionDate,
  MAX(IsAdjustment) AS IsAdjustment
FROM
  (
    SELECT *,
    ROUND(
            CASE 
                WHEN IsPercentage = 1 
                    THEN LineItemAmount * (DistributionAmount / 100.0)
                ELSE DistributionAmount * ISNULL(Quantity, 1)
            END, 2
        ) AS LineItemTotal,
    CASE 
            WHEN ProjectComment IS NOT NULL
      AND TRIM(ProjectComment) &lt;&gt; '' 
            THEN 1
            ELSE 0
        END AS HasProjectComment
  FROM TempFund
  WHERE Rank = 1
) Results
GROUP BY
    FundDescription,
    FundNumber,
    FundDeptNumber,
    FundAccountNumber,
    ProjectNumber,
    PaymentMethod,
    TransactionDate,
    Rank
ORDER BY
    TransactionDate DESC,
    FundDescription;
</CommandText>
    </Query>
    <Fields>
      <Field Name="PaymentMethod">
        <DataField>PaymentMethod</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FundDescription">
        <DataField>FundDescription</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FundNumber">
        <DataField>FundNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FundDeptNumber">
        <DataField>FundDeptNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FundAccountNumber">
        <DataField>FundAccountNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="ProjectNumber">
        <DataField>ProjectNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Rank">
        <DataField>Rank</DataField>
        <rd:TypeName>System.Int64</rd:TypeName>
      </Field>
      <Field Name="Amount">
        <DataField>Amount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
      <Field Name="Total">
        <DataField>Total</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
      <Field Name="TransactionDate">
        <DataField>TransactionDate</DataField>
        <rd:TypeName>System.DateTime</rd:TypeName>
      </Field>
      <Field Name="IsAdjustment">
        <DataField>IsAdjustment</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>