<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@startDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Object</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@endDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Object</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>SELECT        Groups.Description, Fees.Description AS FeeDescription, FeeInputTypes.Type, SUM(FeeDistributions.Amount) AS Amount, Funds.Description AS FundDescription, Funds.FundNumber, Funds.BudgetNumber, 
                         Funds.AccountNumber, Projects.ProjectNumber, Groups.UnitId, FeeDistributions.VersionSetId
FROM            Groups INNER JOIN
                         FeeGroup ON Groups.Id = FeeGroup.GroupsId LEFT OUTER JOIN
                         Fees ON FeeGroup.FeesId = Fees.Id LEFT OUTER JOIN
                         FeeInputTypes ON Fees.InputTypeId = FeeInputTypes.Id LEFT OUTER JOIN
                         FeeDistributions ON Fees.Id = FeeDistributions.FeeId LEFT OUTER JOIN
                         Funds ON FeeDistributions.FundId = Funds.Id LEFT OUTER JOIN
                         Projects ON Funds.Id = Projects.Id
WHERE        (Groups.UnitId = @unitId) AND (FeeDistributions.EffectiveDate &lt;= @startDate) AND (FeeDistributions.EffectiveEndDate IS NULL OR
                         FeeDistributions.EffectiveEndDate &gt; @endDate)
GROUP BY Groups.Description, Fees.Description, FeeInputTypes.Type, FeeDistributions.Amount, Funds.Description, Funds.FundNumber, Funds.BudgetNumber, Funds.AccountNumber, Projects.ProjectNumber, Groups.UnitId, 
                         FeeDistributions.VersionSetId
ORDER BY Groups.Description, FeeDescription</CommandText>
    </Query>
    <Fields>
      <Field Name="Description">
        <DataField>Description</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FeeDescription">
        <DataField>FeeDescription</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Type">
        <DataField>Type</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Amount">
        <DataField>Amount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
      <Field Name="FundDescription">
        <DataField>FundDescription</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="FundNumber">
        <DataField>FundNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="BudgetNumber">
        <DataField>BudgetNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="AccountNumber">
        <DataField>AccountNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="ProjectNumber">
        <DataField>ProjectNumber</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="UnitId">
        <DataField>UnitId</DataField>
        <rd:TypeName>System.Guid</rd:TypeName>
      </Field>
      <Field Name="VersionSetId">
        <DataField>VersionSetId</DataField>
        <rd:TypeName>System.Guid</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>