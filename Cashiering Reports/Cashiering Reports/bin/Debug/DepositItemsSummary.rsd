<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>Cashiering - Dev</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="@startDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@endDate">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>DateTime</rd:DbType>
        </DataSetParameter>
        <DataSetParameter Name="@unitId">
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:UserDefined>true</rd:UserDefined>
          <rd:DbType>String</rd:DbType>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText>SELECT        Fees.Description, SUM(Transactions_LineItems.Amount) AS Amount, DATENAME(m, Transactions_LineItems.CreatedAt) + ' ' + DATENAME(yy, Transactions_LineItems.CreatedAt) AS TransactionDate, 
                         SUM(Transactions_LineItems.Quantity) AS Count, Departments.Name
FROM            Units INNER JOIN
                         Fees ON Units.Id = Fees.UnitId INNER JOIN
                         Transactions_LineItems ON Fees.Id = Transactions_LineItems.FeeId INNER JOIN
                         Departments ON Units.DepartmentId = Departments.Id
WHERE        (Transactions_LineItems.CreatedAt BETWEEN @startDate AND @endDate) AND (Units.Id = @unitId)
GROUP BY Fees.Description, DATENAME(m, Transactions_LineItems.CreatedAt) + ' ' + DATENAME(yy, Transactions_LineItems.CreatedAt), Departments.Name
ORDER BY Fees.Description, TransactionDate</CommandText>
    </Query>
    <Fields>
      <Field Name="Description">
        <DataField>Description</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Amount">
        <DataField>Amount</DataField>
        <rd:TypeName>System.Decimal</rd:TypeName>
      </Field>
      <Field Name="TransactionDate">
        <DataField>TransactionDate</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
      <Field Name="Count">
        <DataField>Count</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
      <Field Name="Name">
        <DataField>Name</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>